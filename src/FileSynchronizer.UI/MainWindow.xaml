<Window x:Class="FileSynchronizer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FileSynchronizer.UI.ViewModels"
        mc:Ignorable="d"
        Title="FileSynchronizer — Automatyczna Synchronizacja Plików &amp; USB"
        Icon="Assets/app.ico"
        Height="820" Width="1240"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status/Progress Bar -->
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FileSynchronizer" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#1E293B" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="PRO 2026" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Klon zaawansowanego mechanizmu GoodSync z automatyzacją USB" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- USB Live Status Indicator -->
                <Border Grid.Column="1" Background="#1E293B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nasłuchiwanie USB aktywne" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT (SPLIT) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="260" MaxWidth="450" /> <!-- Sidebar -->
                <ColumnDefinition Width="1" />                                   <!-- Divider -->
                <ColumnDefinition Width="*" />                                   <!-- Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT SIDEBAR (JOBS LIST) ========== -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header + New button -->
                        <RowDefinition Height="*" />    <!-- Jobs ListBox -->
                        <RowDefinition Height="Auto" /> <!-- USB Drives quick info -->
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="ZADANIA (JOBS)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <Button Content="➕ Nowe" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="12" Command="{Binding AddJobCommand}" />
                    </Grid>

                    <!-- Jobs List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgCardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgCard}" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:JobViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Job Name & Icon -->
                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                        <TextBlock Text="{Binding DirectionIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Auto-sync tag & Direction -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding DirectionName}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="5,2" Visibility="{Binding AutoSyncOnUsbConnect, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="⚡ USB Auto" FontSize="10" Foreground="#34D399" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Last sync info -->
                                    <TextBlock Grid.Row="2" Text="{Binding LastSyncStatus}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- USB Drives Quick Picker Box -->
                    <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="🔌 PODŁĄCZONE PENDRIVE'Y" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Content="🔄" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshDrivesCommand}" ToolTip="Odśwież listę dysków" />
                            </DockPanel>
                            
                            <ItemsControl ItemsSource="{Binding AvailableDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:DriveItemViewModel}">
                                        <Border Background="#0F172A" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                            <DockPanel LastChildFill="True">
                                                <Button Content="Użyj jako Cel" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="6,2" FontSize="10" Command="{Binding DataContext.SelectUsbForRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DynamicUsbUri}" FontSize="9" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Divider Line -->
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrushDark}" />

            <!-- ========== RIGHT WORKSPACE (GOODSYNC SPLIT VIEW) ========== -->
            <Grid Grid.Column="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Job Configuration Card -->
                    <RowDefinition Height="Auto" /> <!-- GoodSync Action Toolbar -->
                    <RowDefinition Height="*" />    <!-- File Diff Split Table -->
                </Grid.RowDefinitions>

                <!-- ===== CARD 1: JOB CONFIGURATION ===== -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Name & Direction Toggle -->
                            <RowDefinition Height="Auto" /> <!-- Paths Selection -->
                            <RowDefinition Height="Auto" /> <!-- USB Auto-sync Settings -->
                        </Grid.RowDefinitions>

                        <!-- Job Title & Direction & Delete Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Name input -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Nazwa zadania:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SelectedJob.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Direction Radio Buttons -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                <TextBlock Text="Tryb działania:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Kopia 1-kierunkowa (Backup ➡️)" IsChecked="{Binding SelectedJob.IsOneWayBackup}" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0" />
                                    <RadioButton Content="Synchronizacja 2-kierunkowa (🔄)" IsChecked="{Binding SelectedJob.IsTwoWaySync}" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Delete Job Button -->
                            <Button Grid.Column="2" Content="🗑️ Usuń zadanie" Style="{StaticResource OutlineButton}" Foreground="{StaticResource AccentDanger}" BorderBrush="#7F1D1D" VerticalAlignment="Bottom" Command="{Binding DeleteJobCommand}" />
                        </Grid>

                        <!-- Paths Selection (Left vs Right) -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT PATH (Source) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📂 Folder źródłowy (Left / PC):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedJob.LeftPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,6,0" />
                                    <Button Content="Przeglądaj..." Grid.Column="1" Style="{StaticResource OutlineButton}" Command="{Binding BrowseLeftFolderCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedJob.LeftFriendlyDisplay}" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0" Visibility="{Binding SelectedJob.IsLeftUsb, Converter={StaticResource BoolToVisConverter}}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Middle Arrow Indicator -->
                            <TextBlock Grid.Column="1" Text="{Binding SelectedJob.DirectionIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0" Foreground="{StaticResource AccentPrimary}" />

                            <!-- RIGHT PATH (Target / USB) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="💾 Folder docelowy / USB (Right):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedJob.RightPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Margin="0,0,6,0" />
                                    <Button Content="Przeglądaj..." Grid.Column="1" Style="{StaticResource OutlineButton}" Command="{Binding BrowseRightFolderCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedJob.RightFriendlyDisplay}" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0" Visibility="{Binding SelectedJob.IsRightUsb, Converter={StaticResource BoolToVisConverter}}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- USB Auto-Sync Options -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding SelectedJob.AutoSyncOnUsbConnect}" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="⚡ Uruchamiaj synchronizację automatycznie po wpięciu przypisanego USB" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SelectedJob.DeleteOrphanFilesOnTarget}" VerticalAlignment="Center" Visibility="{Binding SelectedJob.IsOneWayBackup, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="🗑️ Usuwaj z celu pliki skasowane ze źródła (kopia lustrzana)" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== CARD 2: GOODSYNC ACTION TOOLBAR ===== -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Button 1: Analyze -->
                        <Button Grid.Column="0" Content="🔍 1. ANALIZUJ" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Command="{Binding AnalyzeCommand}" ToolTip="Porównaj zawartość folderów i wylicz plan akcji" />

                        <!-- Button 2: Sync -->
                        <Button Grid.Column="1" Content="🔄 2. SYNCHRONIZUJ" Style="{StaticResource SuccessButton}" Margin="0,0,12,0" Command="{Binding SyncCommand}" ToolTip="Wykonaj zaplanowane operacje kopiowania i usuwania" />

                        <!-- Cancel Button (when busy) -->
                        <Button Grid.Column="2" Content="⏹️ Anuluj" Style="{StaticResource OutlineButton}" Foreground="{StaticResource AccentDanger}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />

                        <!-- Metrics Summary Badges -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Total files -->
                            <Border Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Wszystkie: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="{Binding PlanTotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Actions required -->
                            <Border Background="#1E3A8A" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Do wykonania: " Foreground="#93C5FD" FontSize="12" />
                                    <TextBlock Text="{Binding PlanActionsCount}" FontWeight="Bold" Foreground="#BFDBFE" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Conflicts -->
                            <Border Background="#78350F" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" Visibility="{Binding PlanConflictsCount, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ Konflikty: " Foreground="#FCD34D" FontSize="12" />
                                    <TextBlock Text="{Binding PlanConflictsCount}" FontWeight="Bold" Foreground="#FEF3C7" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Size -->
                            <Border Background="#0F172A" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rozmiar: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="{Binding PlanSizeFormatted}" FontWeight="Bold" Foreground="{StaticResource AccentSuccess}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== CARD 3: FILE DIFF SPLIT TABLE ===== -->
                <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Empty Placeholder View when no items analyzed -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasPlan, Converter={StaticResource InverseBoolToVisConverter}}">
                            <TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6" />
                            <TextBlock Text="Brak przeanalizowanych danych" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Wybierz foldery powyżej i kliknij przycisk '1. ANALIZUJ', aby porównać pliki." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,16" HorizontalAlignment="Center" />
                            <Button Content="Uruchom Analizę Teraz" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Command="{Binding AnalyzeCommand}" />
                        </StackPanel>

                        <!-- DataGrid for File Differences -->
                        <DataGrid ItemsSource="{Binding PlanItems}"
                                  Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisConverter}}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#22334155"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#0A0F172A"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  Foreground="{StaticResource TextPrimary}">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Left File info -->
                                <DataGridTemplateColumn Header="ŹRÓDŁO (LEFT / PC)" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:SyncItemViewModel}">
                                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding LeftExists, Converter={StaticResource BoolToVisConverter}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RelativePath}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding LeftExists, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding LeftSize, Converter={StaticResource BytesToStringConverter}}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding LeftModifiedFormatted}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Middle Action Badge -->
                                <DataGridTemplateColumn Header="AKCJA" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:SyncItemViewModel}">
                                            <Border Background="{Binding Action, Converter={StaticResource ActionToBgBrushConverter}}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActionIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActionText}" FontSize="11" FontWeight="Bold" Foreground="{Binding Action, Converter={StaticResource ActionToColorConverter}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Right File info -->
                                <DataGridTemplateColumn Header="CEL (RIGHT / USB)" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:SyncItemViewModel}">
                                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding RightExists, Converter={StaticResource BoolToVisConverter}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RelativePath}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding RightExists, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding RightSize, Converter={StaticResource BytesToStringConverter}}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding RightModifiedFormatted}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Column -->
                                <DataGridTemplateColumn Header="STATUS" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type viewmodels:SyncItemViewModel}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding StatusIcon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= BOTTOM STATUS & PROGRESS BAR ================= -->
        <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Text + Speed & Counts -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding CurrentItemText}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SpeedText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentSuccess}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ProgressCountText}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Maximum="100" />
            </Grid>
        </Border>
    </Grid>
</Window>
